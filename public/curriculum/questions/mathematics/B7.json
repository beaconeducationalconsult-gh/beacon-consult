{"subjectId":"mathematics","grade":"B7","items":[{"id":"B7.1.1.1.1-authored-1","indicatorCode":"B7.1.1.1.1","prompt":"What is the place value of the digit 7 in the number 3,472,000,000?","type":"mcq","options":["Ten millions","Hundred millions","Millions","Billions"],"answer":"Ten millions","answerLetter":"A","marks":1,"difficulty":"core","source":"authored"},{"id":"B7.1.1.1.1-authored-2","indicatorCode":"B7.1.1.1.1","prompt":"Write 2,045,000,000 in words.","type":"short","options":null,"answer":"Two billion, forty-five million","answerLetter":null,"marks":3,"difficulty":"core","source":"authored"},{"id":"B7.1.1.1.1-authored-3","indicatorCode":"B7.1.1.1.1","prompt":"Write nine billion, three hundred and six million, eighty thousand and seventy in figures.","type":"short","options":null,"answer":"9,306,080,070","answerLetter":null,"marks":3,"difficulty":"core","source":"authored"},{"id":"B7.1.2.1.2-authored-1","indicatorCode":"B7.1.2.1.2","prompt":"A shop sells pens at GH¢2.00 each. How much will 25 pens cost?","type":"mcq","options":["GH¢50.00","GH¢40.00","GH¢45.00","GH¢55.00"],"answer":"GH¢50.00","answerLetter":"A","marks":1,"difficulty":"core","source":"authored"},{"id":"B7.1.2.1.2-authored-2","indicatorCode":"B7.1.2.1.2","prompt":"Kofi bought 3 exercise books at GH¢4.50 each and paid with a GH¢20.00 note. How much change did he receive?","type":"short","options":null,"answer":"GH¢6.50","answerLetter":null,"marks":3,"difficulty":"core","source":"authored"},{"id":"B7.1.2.1.2-authored-3","indicatorCode":"B7.1.2.1.2","prompt":"A class of 45 pupils is divided into 9 equal groups. How many pupils are in each group?","type":"short","options":null,"answer":"5 pupils","answerLetter":null,"marks":2,"difficulty":"core","source":"authored"},{"id":"B7.1.2.2.1-authored-1","indicatorCode":"B7.1.2.2.1","prompt":"Which of these is the sum of 3,456 and 1,544?","type":"mcq","options":["5,100","5,000","4,900","5,010"],"answer":"5,000","answerLetter":"B","marks":1,"difficulty":"core","source":"authored"},{"id":"B7.1.2.2.1-authored-2","indicatorCode":"B7.1.2.2.1","prompt":"Work out 4,308 + 2,795.","type":"short","options":null,"answer":"7,103","answerLetter":null,"marks":2,"difficulty":"core","source":"authored"},{"id":"B7.1.2.2.1-authored-3","indicatorCode":"B7.1.2.2.1","prompt":"Work out 9,002 - 4,736.","type":"short","options":null,"answer":"4,266","answerLetter":null,"marks":2,"difficulty":"core","source":"authored"},{"id":"B7.1.2.3.2-authored-1","indicatorCode":"B7.1.2.3.2","prompt":"Which of these is 5 × 5 × 5 written in index form?","type":"mcq","options":["5³","3 × 5","15","53"],"answer":"5³","answerLetter":"A","marks":1,"difficulty":"core","source":"authored"},{"id":"B7.1.2.3.2-authored-2","indicatorCode":"B7.1.2.3.2","prompt":"Express 72 as a product of its prime factors, giving your answer in index form.","type":"short","options":null,"answer":"2³ × 3²","answerLetter":null,"marks":3,"difficulty":"core","source":"authored"},{"id":"B7.1.2.3.2-authored-3","indicatorCode":"B7.1.2.3.2","prompt":"Express 100 as a product of powers of 2 and 5.","type":"short","options":null,"answer":"2² × 5²","answerLetter":null,"marks":2,"difficulty":"core","source":"authored"},{"id":"B7.1.3.2.2-authored-1","indicatorCode":"B7.1.3.2.2","prompt":"What is 2/3 + 1/6?","type":"mcq","options":["1/2","3/6","3/9","5/6"],"answer":"5/6","answerLetter":"D","marks":1,"difficulty":"core","source":"authored"},{"id":"B7.1.3.2.2-authored-2","indicatorCode":"B7.1.3.2.2","prompt":"Work out 3/4 + 1/6, leaving your answer as a fraction in its simplest form.","type":"short","options":null,"answer":"11/12","answerLetter":null,"marks":3,"difficulty":"core","source":"authored"},{"id":"B7.1.3.2.2-authored-3","indicatorCode":"B7.1.3.2.2","prompt":"Work out 5/8 - 1/4.","type":"short","options":null,"answer":"3/8","answerLetter":null,"marks":2,"difficulty":"core","source":"authored"},{"id":"B7.2.2.1.3-authored-1","indicatorCode":"B7.2.2.1.3","prompt":"Simplify 15y ÷ 3.","type":"mcq","options":["12y","5","45y","5y"],"answer":"5y","answerLetter":"D","marks":1,"difficulty":"core","source":"authored"},{"id":"B7.2.2.1.3-authored-2","indicatorCode":"B7.2.2.1.3","prompt":"Simplify 6x × 3.","type":"short","options":null,"answer":"18x","answerLetter":null,"marks":2,"difficulty":"core","source":"authored"},{"id":"B7.2.2.1.3-authored-3","indicatorCode":"B7.2.2.1.3","prompt":"Simplify 12x² ÷ 4x.","type":"short","options":null,"answer":"3x","answerLetter":null,"marks":2,"difficulty":"core","source":"authored"},{"id":"B7.2.2.1.3-authored-4","indicatorCode":"B7.2.2.1.3","prompt":"Simplify ½ × 8y.","type":"short","options":null,"answer":"4y","answerLetter":null,"marks":2,"difficulty":"reinforcement","source":"authored"},{"id":"B7.3.1.1.1-authored-1","indicatorCode":"B7.3.1.1.1","prompt":"An angle of 145° is best described as","type":"mcq","options":["an acute angle","a right angle","a reflex angle","an obtuse angle"],"answer":"an obtuse angle","answerLetter":"D","marks":1,"difficulty":"core","source":"authored"},{"id":"B7.3.1.1.1-authored-2","indicatorCode":"B7.3.1.1.1","prompt":"An angle of 250° is best described as","type":"mcq","options":["a reflex angle","an acute angle","an obtuse angle","a right angle"],"answer":"a reflex angle","answerLetter":"A","marks":1,"difficulty":"core","source":"authored"},{"id":"B7.3.1.1.1-authored-3","indicatorCode":"B7.3.1.1.1","prompt":"What is the size of a right angle?","type":"short","options":null,"answer":"90°","answerLetter":null,"marks":1,"difficulty":"core","source":"authored"},{"id":"B7.3.1.1.3-authored-1","indicatorCode":"B7.3.1.1.3","prompt":"Two angles are vertically opposite to each other. If one of them is 65°, what is the size of the other?","type":"mcq","options":["25°","115°","125°","65°"],"answer":"65°","answerLetter":"D","marks":1,"difficulty":"core","source":"authored"},{"id":"B7.3.1.1.3-authored-2","indicatorCode":"B7.3.1.1.3","prompt":"Two angles lie on a straight line. One of them is 118°. Find the size of the other angle.","type":"short","options":null,"answer":"62°","answerLetter":null,"marks":2,"difficulty":"core","source":"authored"},{"id":"B7.3.1.1.3-authored-3","indicatorCode":"B7.3.1.1.3","prompt":"Two complementary angles are such that one of them is 38°. Find the size of the other angle.","type":"short","options":null,"answer":"52°","answerLetter":null,"marks":2,"difficulty":"core","source":"authored"},{"id":"B7.3.1.1.3-authored-4","indicatorCode":"B7.3.1.1.3","prompt":"Two angles on a straight line are 3x and 2x. Find the value of x.","type":"short","options":null,"answer":"x = 36°","answerLetter":null,"marks":3,"difficulty":"core","source":"authored"},{"id":"B7.3.1.2.1-authored-1","indicatorCode":"B7.3.1.2.1","prompt":"Using a ruler and a pair of compasses only, construct a line segment PQ of length 6 cm. Then construct a line through P perpendicular to PQ. Show all construction arcs clearly.","type":"essay","options":null,"answer":"Marking scheme: 1 mark for drawing PQ = 6 cm; 1 mark for marking two points A and B on the line either side of P at equal distances from P; 2 marks for arcs from A and B (radius greater than PA) meeting at a point C; 1 mark for joining C to P. The angle between CP and PQ must measure 90°.","answerLetter":null,"marks":5,"difficulty":"core","source":"authored"},{"id":"B7.3.1.2.1-authored-2","indicatorCode":"B7.3.1.2.1","prompt":"Which two instruments are used to construct a perpendicular with arcs rather than with a protractor?","type":"short","options":null,"answer":"A ruler and a pair of compasses","answerLetter":null,"marks":1,"difficulty":"reinforcement","source":"authored"},{"id":"B7.3.1.2.2-authored-1","indicatorCode":"B7.3.1.2.2","prompt":"Construct the perpendicular bisector of a line segment AB of length 7.2 cm. Mark the midpoint of AB as M and label the bisector.","type":"essay","options":null,"answer":"Marking scheme: 1 mark for AB = 7.2 cm; 2 marks for arcs of equal radius from A and from B crossing above and below the segment; 1 mark for joining the two crossings; 1 mark for marking M correctly at 3.6 cm from A (and the bisector meeting AB at 90°).","answerLetter":null,"marks":5,"difficulty":"core","source":"authored"},{"id":"B7.3.1.2.2-authored-2","indicatorCode":"B7.3.1.2.2","prompt":"P is a point on the perpendicular bisector of AB and PA = 5 cm. Find PB.","type":"short","options":null,"answer":"PB = 5 cm","answerLetter":null,"marks":2,"difficulty":"core","source":"authored"},{"id":"B7.3.1.2.3-authored-1","indicatorCode":"B7.3.1.2.3","prompt":"With a ruler and a pair of compasses, construct an angle of 60° and then bisect it. State the size of each of the two parts.","type":"essay","options":null,"answer":"Marking scheme: 2 marks for the arcs that give 60° (an equilateral triangle built on a ray); 2 marks for the arc from the vertex that cuts both arms and the final ray from the vertex through the crossing; 1 mark for stating that each part is 30°.","answerLetter":null,"marks":5,"difficulty":"core","source":"authored"},{"id":"B7.3.1.2.3-authored-2","indicatorCode":"B7.3.1.2.3","prompt":"An angle of 76° is bisected. What is the size of each of the two parts?","type":"short","options":null,"answer":"38°","answerLetter":null,"marks":2,"difficulty":"core","source":"authored"},{"id":"B7.3.1.2.7-authored-1","indicatorCode":"B7.3.1.2.7","prompt":"A fold that divides the corner of a sheet of paper into two equal angles is an example of","type":"mcq","options":["a line segment","a reflex angle","an angle bisector","a perpendicular bisector"],"answer":"an angle bisector","answerLetter":"C","marks":1,"difficulty":"core","source":"authored"},{"id":"B7.3.1.2.7-authored-2","indicatorCode":"B7.3.1.2.7","prompt":"Give one example of perpendicular line segments that you can see in your classroom.","type":"short","options":null,"answer":"Any correct example, e.g. where the wall meets the floor, the corner of the chalkboard, the edges of the door frame. The two lines must meet at 90°.","answerLetter":null,"marks":2,"difficulty":"core","source":"authored"},{"id":"B7.3.1.2.7-authored-3","indicatorCode":"B7.3.1.2.7","prompt":"In football, the halfway line meets each touchline. What is the angle between the two lines?","type":"short","options":null,"answer":"90° - they are perpendicular","answerLetter":null,"marks":1,"difficulty":"core","source":"authored"},{"id":"B7.3.2.1.3-authored-1","indicatorCode":"B7.3.2.1.3","prompt":"On graph paper or in your exercise book, draw a rectangle measuring 5 cm by 3 cm and a right-angled triangle with base 4 cm and height 3 cm. State the area of the rectangle.","type":"essay","options":null,"answer":"Marking scheme: 2 marks for the rectangle drawn to 5 cm by 3 cm; 2 marks for the right-angled triangle with base 4 cm and height 3 cm; 1 mark for the area of the rectangle = 15 cm².","answerLetter":null,"marks":5,"difficulty":"core","source":"authored"},{"id":"B7.3.2.1.3-authored-2","indicatorCode":"B7.3.2.1.3","prompt":"A rectangle measures 7 cm by 2 cm. How many 1 cm by 1 cm squares are needed to cover it?","type":"short","options":null,"answer":"14 squares","answerLetter":null,"marks":2,"difficulty":"core","source":"authored"},{"id":"B7.3.3.2.3-authored-1","indicatorCode":"B7.3.3.2.3","prompt":"Which of the following is a vector quantity?","type":"mcq","options":["Mass","Time","Speed","Displacement"],"answer":"Displacement","answerLetter":"D","marks":1,"difficulty":"core","source":"authored"},{"id":"B7.3.3.2.3-authored-2","indicatorCode":"B7.3.3.2.3","prompt":"Which of the following is a scalar quantity?","type":"mcq","options":["Force","Displacement","Temperature","Velocity"],"answer":"Temperature","answerLetter":"C","marks":1,"difficulty":"core","source":"authored"},{"id":"B7.3.3.2.3-authored-3","indicatorCode":"B7.3.3.2.3","prompt":"State whether each of the following is a scalar or a vector: (i) 5 km  (ii) 5 km due North.","type":"short","options":null,"answer":"(i) scalar  (ii) vector","answerLetter":null,"marks":2,"difficulty":"core","source":"authored"},{"id":"B7.3.3.3.4-authored-1","indicatorCode":"B7.3.3.3.4","prompt":"Which of the following is true of similar shapes?","type":"mcq","options":["They always have the same area","They have the same shape and the same size","They have the same shape but not necessarily the same size","They always have the same size"],"answer":"They have the same shape but not necessarily the same size","answerLetter":"C","marks":1,"difficulty":"core","source":"authored"},{"id":"B7.3.3.3.4-authored-2","indicatorCode":"B7.3.3.3.4","prompt":"Triangle ABC has vertices A(1, 1), B(4, 1) and C(1, 3). It is translated 3 units to the right to give A'B'C'. Are the triangle and its image congruent? Give a reason.","type":"short","options":null,"answer":"Yes. A translation moves a shape without changing its size or its shape, so the image is congruent to the object.","answerLetter":null,"marks":3,"difficulty":"core","source":"authored"},{"id":"B7.3.3.3.4-authored-3","indicatorCode":"B7.3.3.3.4","prompt":"The sides of one triangle are 3 cm, 4 cm and 5 cm. The sides of another triangle are 6 cm, 8 cm and 10 cm. Are the two triangles similar? Give a reason.","type":"short","options":null,"answer":"Yes. Each side of the second triangle is twice the corresponding side of the first, so the sides are in the same ratio and the shapes are the same.","answerLetter":null,"marks":3,"difficulty":"core","source":"authored"},{"id":"B7.4.1.1.1-authored-1","indicatorCode":"B7.4.1.1.1","prompt":"To find out the favourite subject of every pupil in a school, the best method is to","type":"mcq","options":["make a guess","measure the pupils","carry out a survey","carry out an experiment"],"answer":"carry out a survey","answerLetter":"C","marks":1,"difficulty":"core","source":"authored"},{"id":"B7.4.1.1.1-authored-2","indicatorCode":"B7.4.1.1.1","prompt":"You want to find out how many hours the pupils of your class spend on homework each week. Which method would you use to collect the data, and why?","type":"short","options":null,"answer":"A survey - a questionnaire or an interview - because it asks every pupil the same question and the answers can be recorded as numbers of hours.","answerLetter":null,"marks":3,"difficulty":"core","source":"authored"},{"id":"B7.4.1.1.2-authored-1","indicatorCode":"B7.4.1.1.2","prompt":"Design a questionnaire of four questions to find out how the pupils in your school travel to school. State how you would record the answers.","type":"essay","options":null,"answer":"Marking scheme: 1 mark for each sensible question (4 marks); the questions should be closed with answer options such as on foot, bicycle, car, bus, trotro. 1 mark for saying the answers are recorded in a tally chart or frequency table with one row or column for each means of travel.","answerLetter":null,"marks":5,"difficulty":"core","source":"authored"},{"id":"B7.4.1.1.2-authored-2","indicatorCode":"B7.4.1.1.2","prompt":"Write one question you would put in a questionnaire to find out how many people live in each house, together with the answer options you would use.","type":"short","options":null,"answer":"Any closed question, e.g. \"How many people live in your house?\" with options 1 - 3, 4 - 6, 7 - 9, 10 or more.","answerLetter":null,"marks":2,"difficulty":"core","source":"authored"},{"id":"B7.4.1.1.3-authored-1","indicatorCode":"B7.4.1.1.3","prompt":"In a bar chart, one unit on the vertical axis stands for 5 pupils. The bar for football is 6 units high. How many pupils chose football?","type":"mcq","options":["30","6","11","25"],"answer":"30","answerLetter":"A","marks":1,"difficulty":"core","source":"authored"},{"id":"B7.4.1.1.3-authored-2","indicatorCode":"B7.4.1.1.3","prompt":"In a survey, ten pupils chose their favourite fruit as follows: mango, orange, mango, banana, mango, orange, banana, mango, mango, orange. Make a frequency table of the data.","type":"short","options":null,"answer":"Mango 5; Orange 3; Banana 2. Total 10 pupils.","answerLetter":null,"marks":3,"difficulty":"core","source":"authored"},{"id":"B7.4.1.1.3-authored-3","indicatorCode":"B7.4.1.1.3","prompt":"From the fruit survey above, which fruit was chosen most often?","type":"short","options":null,"answer":"Mango","answerLetter":null,"marks":1,"difficulty":"core","source":"authored"},{"id":"B7.4.2.1.1-authored-1","indicatorCode":"B7.4.2.1.1","prompt":"A fair coin is tossed once. Which of these events is certain?","type":"mcq","options":["It lands on heads","It lands on tails","It lands on its edge","It lands on heads or on tails"],"answer":"It lands on heads or on tails","answerLetter":"D","marks":1,"difficulty":"core","source":"authored"},{"id":"B7.4.2.1.1-authored-2","indicatorCode":"B7.4.2.1.1","prompt":"Classify each of these events as impossible, possible or certain: (i) The sun will rise tomorrow. (ii) A fair die shows 7 when it is thrown once.","type":"short","options":null,"answer":"(i) certain  (ii) impossible","answerLetter":null,"marks":2,"difficulty":"core","source":"authored"},{"id":"B7.4.2.1.1-authored-3","indicatorCode":"B7.4.2.1.1","prompt":"Give one event from your own life that is impossible and one that is certain.","type":"short","options":null,"answer":"Any sensible pair, e.g. impossible: I will grow wings and fly; certain: I will breathe today.","answerLetter":null,"marks":2,"difficulty":"core","source":"authored"},{"id":"B7.1.1.1.3-rounding-1","indicatorCode":"B7.1.1.1.3","prompt":"Round 105,022,157 to the nearest thousand.","type":"mcq","options":["105,022,000","105,021,000","105,023,000"],"answer":"105,022,000","answerLetter":"A","marks":1,"difficulty":"core","source":"generated:rounding"},{"id":"B7.1.1.1.4-round-decimals-1","indicatorCode":"B7.1.1.1.4","prompt":"Round 48.385 to the nearest hundredth.","type":"mcq","options":["48.39","48.385","48.38"],"answer":"48.38","answerLetter":"C","marks":1,"difficulty":"core","source":"generated:round-decimals"},{"id":"B7.1.1.1.4-round-decimals-2","indicatorCode":"B7.1.1.1.4","prompt":"Round 18.545 to the nearest hundredth.","type":"short","options":null,"answer":"18.55","marks":2,"difficulty":"core","source":"generated:round-decimals"},{"id":"B7.1.1.1.5-decimals-1","indicatorCode":"B7.1.1.1.5","prompt":"Write 39.8 as a fraction in its simplest form.","type":"short","options":null,"answer":"199/5","marks":2,"difficulty":"core","source":"generated:decimals"},{"id":"B7.1.1.1.5-jhs-significant-figures-2","indicatorCode":"B7.1.1.1.5","prompt":"Express 27.3941 correct to 4 significant figures.","type":"short","options":null,"answer":"27.39","marks":2,"difficulty":"core","source":"generated:jhs-significant-figures"},{"id":"B7.1.1.1.5-jhs-significant-figures-3","indicatorCode":"B7.1.1.1.5","prompt":"Express 27.3941 correct to 1 decimal place(s).","type":"short","options":null,"answer":"27.4","marks":2,"difficulty":"core","source":"generated:jhs-significant-figures"},{"id":"B7.1.2.1.1-multiples-1","indicatorCode":"B7.1.2.1.1","prompt":"Write the first five multiples of 6.","type":"short","options":null,"answer":"6, 12, 18, 24, 30","marks":2,"difficulty":"core","source":"generated:multiples"},{"id":"B7.1.2.1.1-multiples-2","indicatorCode":"B7.1.2.1.1","prompt":"Which of these is a multiple of 6?","type":"mcq","options":["17","18","19","20"],"answer":"18","answerLetter":"B","marks":1,"difficulty":"core","source":"generated:multiples"},{"id":"B7.1.2.1.1-multiplication-3","indicatorCode":"B7.1.2.1.1","prompt":"Multiply: 4 x 6 = ","type":"short","options":null,"answer":"24","marks":2,"difficulty":"core","source":"generated:multiplication"},{"id":"B7.1.2.1.1-division-4","indicatorCode":"B7.1.2.1.1","prompt":"Divide: 200 ÷ 25 = ","type":"short","options":null,"answer":"8","marks":2,"difficulty":"core","source":"generated:division"},{"id":"B7.1.2.1.1-decimals-5","indicatorCode":"B7.1.2.1.1","prompt":"Write 87.38 as a fraction in its simplest form.","type":"short","options":null,"answer":"4369/50","marks":2,"difficulty":"core","source":"generated